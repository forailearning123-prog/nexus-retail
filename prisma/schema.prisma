generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  isGuest   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique // e.g., "Bottles", "Home Decoration", "Jewelries"
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float    // Stored in INR
  imageUrl    String?  // R2 Bucket URL
  stock       Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  totalAmount    Float
  status         String      @default("PENDING") // PENDING, PAID, SHIPPED, DELIVERED, CANCELLED
  razorpayId     String?     // Razorpay Order ID or Payment ID
  invoiceUrl     String?     // S3/R2 URL for generated invoice
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model CmsContent {
  id        String   @id @default(cuid())
  pageName  String   @unique // e.g. "HOME_MARKETING"
  content   Json     // Storing layout/component config as JSON
  updatedAt DateTime @updatedAt
}
